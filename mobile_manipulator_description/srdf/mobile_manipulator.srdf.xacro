<?xml version="1.0"?>
<!-- Planning groups use chains, so they stay valid for any arm / lift that follows the contracts
     (no joint names to keep in sync). Adjacent-link collision exclusions inside the arm are
     arm-specific: generate the full allowed-collision matrix per arm (MoveIt Setup Assistant or
     a script) and include it from the profile's own SRDF. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_manipulator">
  <!-- Arm only (6-DOF): used for in-band work with the lift locked. -->
  <group name="arm">
    <chain base_link="arm_base_link" tip_link="tcp_link"/>
  </group>

  <!-- Lift + arm (7-DOF): whole-body planning, lift as the first joint. -->
  <group name="lift_arm">
    <chain base_link="base_link" tip_link="tcp_link"/>
  </group>

  <group name="tool">
    <link name="tool_mount_link"/>
    <link name="tcp_link"/>
  </group>

  <end_effector name="tool" parent_link="tool_mount_link" group="tool" parent_group="arm"/>


  <!-- Structural exclusions that hold for every lift / base. -->
  <disable_collisions link1="base_link" link2="lift_base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="lift_carriage_link" reason="Never"/>
  <disable_collisions link1="lift_base_link" link2="lift_carriage_link" reason="Adjacent"/>
  <disable_collisions link1="lift_base_link" link2="lift_stage_1_link" reason="Adjacent"/>
  <disable_collisions link1="lift_stage_1_link" link2="lift_stage_2_link" reason="Adjacent"/>
  <disable_collisions link1="lift_stage_2_link" link2="lift_carriage_link" reason="Adjacent"/>
  <disable_collisions link1="lift_stage_1_link" link2="lift_carriage_link" reason="Never"/>
  <disable_collisions link1="lift_carriage_link" link2="tool_mount_link" reason="Never"/>
  <disable_collisions link1="tool_mount_link" link2="arm_wrist_3_link" reason="Adjacent"/>
</robot>
