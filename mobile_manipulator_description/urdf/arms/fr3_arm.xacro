<?xml version="1.0"?>
<!-- Franka Research 3 (7-DOF), primitives only. Joint frames: kinematics.yaml of franka_description
     (Apache-2.0; read, not copied) = the Craig DH table a 0 / 0 / 0 / 0.0825 / -0.0825 / 0 / 0.088,
     d 0.333 / 0 / 0.316 / 0 / 0.384 / 0 / 0 and flange 0.107, alpha 0, -90, 90, 90, -90, 90, 90 deg.
     Limits and velocity / effort: joint_limits.yaml of the same package (q1..q7 +-2.9007 / +-1.8361 /
     +-2.9007 / [-3.0770, -0.1169] / +-2.8763 / [0.4398, 4.6216] / +-3.0508 rad; 2.62 rad/s for
     q1-q4, 5.26 / 4.18 / 5.26 for q5-q7; 87 N m for q1-q4, 12 N m for q5-q7). No vendor mesh. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="fr3_arm" params="parent *origin prefix:='arm_'">
    <xacro:sa_base prefix="${prefix}" parent="${parent}"><xacro:insert_block name="origin"/></xacro:sa_base>

    <xacro:sa_link name="${prefix}link1" radius="0.06" from_z="-0.333" to_z="0"/>
    <xacro:sa_joint prefix="${prefix}" n="1" parent="${prefix}base_link" child="${prefix}link1"
      xyz="0 0 0.333" lower="-2.9007" upper="2.9007" velocity="2.62" effort="87"/>

    <xacro:sa_link name="${prefix}link2" radius="0.06" to_y="-0.316"/>
    <xacro:sa_joint prefix="${prefix}" n="2" parent="${prefix}link1" child="${prefix}link2"
      rpy="${-pi/2} 0 0" lower="-1.8361" upper="1.8361" velocity="2.62" effort="87"/>

    <xacro:sa_link name="${prefix}link3" radius="0.055" to_x="0.0825"/>
    <xacro:sa_joint prefix="${prefix}" n="3" parent="${prefix}link2" child="${prefix}link3"
      xyz="0 -0.316 0" rpy="${pi/2} 0 0" lower="-2.9007" upper="2.9007" velocity="2.62" effort="87"/>

    <xacro:sa_link name="${prefix}link4" radius="0.05" to_x="-0.0825" to_y="0.384"/>
    <xacro:sa_joint prefix="${prefix}" n="4" parent="${prefix}link3" child="${prefix}link4"
      xyz="0.0825 0 0" rpy="${pi/2} 0 0" lower="-3.0770" upper="-0.1169" velocity="2.62" effort="87"/>

    <xacro:sa_link name="${prefix}link5" radius="0.045"/>
    <xacro:sa_joint prefix="${prefix}" n="5" parent="${prefix}link4" child="${prefix}link5"
      xyz="-0.0825 0.384 0" rpy="${-pi/2} 0 0" lower="-2.8763" upper="2.8763" velocity="5.26" effort="12"/>

    <xacro:sa_link name="${prefix}link6" radius="0.05" to_x="0.088"/>
    <xacro:sa_joint prefix="${prefix}" n="6" parent="${prefix}link5" child="${prefix}link6"
      rpy="${pi/2} 0 0" lower="0.4398" upper="4.6216" velocity="4.18" effort="12"/>

    <xacro:sa_link name="${prefix}link7" radius="0.04" to_z="0.107"/>
    <xacro:sa_joint prefix="${prefix}" n="7" parent="${prefix}link6" child="${prefix}link7"
      xyz="0.088 0 0" rpy="${pi/2} 0 0" lower="-3.0508" upper="3.0508" velocity="5.26" effort="12"/>

    <xacro:sa_flange prefix="${prefix}" last="${prefix}link7" xyz="0 0 0.107"/>
  </xacro:macro>
</robot>
