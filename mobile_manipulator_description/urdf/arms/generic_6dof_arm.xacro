<?xml version="1.0"?>
<!-- Reference 6-DOF arm with UR-like proportions and axis pattern (z, y, y, y, z, y) built from
     primitives. Joint limits are +-pi on purpose: a 4*pi range gives every pose several
     full-turn equivalents and a numerical IK solver (KDL) happily returns a far one for a tiny
     move. Real arms with +-2*pi joints need a solver that prefers the seed (pick_ik, TRAC-IK). Needs no external package, so tests and CI can run anywhere. It also documents
     the arm contract (see arms/arm.xacro). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gen_link" params="name length radius xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${name}">
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="arm_blue"><color rgba="0.2 0.4 0.8 1"/></material>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <inertial><mass value="3.0"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.02"/></inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="generic_6dof_arm" params="parent *origin prefix:='arm_'">


    <link name="${prefix}base_link"/>
    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <xacro:gen_link name="${prefix}shoulder_link" length="0.18" radius="0.07" xyz="0 0 0.09"/>
    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}base_link"/><child link="${prefix}shoulder_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
      <limit lower="${-pi}" upper="${pi}" effort="330" velocity="2.09"/>
    </joint>

    <xacro:gen_link name="${prefix}upper_arm_link" length="0.612" radius="0.055" xyz="0 0.12 0.306"/>
    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}shoulder_link"/><child link="${prefix}upper_arm_link"/>
      <origin xyz="0 0 0.18" rpy="0 0 0"/><axis xyz="0 1 0"/>
      <limit lower="${-pi}" upper="${pi}" effort="330" velocity="2.09"/>
    </joint>

    <xacro:gen_link name="${prefix}forearm_link" length="0.572" radius="0.045" xyz="0 0 0.286"/>
    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}upper_arm_link"/><child link="${prefix}forearm_link"/>
      <origin xyz="0 -0.12 0.612" rpy="0 0 0"/><axis xyz="0 1 0"/>
      <limit lower="${-pi}" upper="${pi}" effort="150" velocity="3.14"/>
    </joint>

    <xacro:gen_link name="${prefix}wrist_1_link" length="0.12" radius="0.04" xyz="0 0.06 0"/>
    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}forearm_link"/><child link="${prefix}wrist_1_link"/>
      <origin xyz="0 0 0.572" rpy="0 0 0"/><axis xyz="0 1 0"/>
      <limit lower="${-pi}" upper="${pi}" effort="54" velocity="3.14"/>
    </joint>

    <xacro:gen_link name="${prefix}wrist_2_link" length="0.12" radius="0.04" xyz="0 0 0.06"/>
    <joint name="${prefix}joint5" type="revolute">
      <parent link="${prefix}wrist_1_link"/><child link="${prefix}wrist_2_link"/>
      <origin xyz="0 0.12 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
      <limit lower="${-pi}" upper="${pi}" effort="54" velocity="3.14"/>
    </joint>

    <xacro:gen_link name="${prefix}wrist_3_link" length="0.06" radius="0.035" xyz="0 0.03 0"/>
    <joint name="${prefix}joint6" type="revolute">
      <parent link="${prefix}wrist_2_link"/><child link="${prefix}wrist_3_link"/>
      <origin xyz="0 0 0.12" rpy="0 0 0"/><axis xyz="0 1 0"/>
      <limit lower="${-pi}" upper="${pi}" effort="54" velocity="3.14"/>
    </joint>

    <!-- Arm contract: the flange, z pointing out of the last link. -->
    <link name="${prefix}flange_link"/>
    <joint name="${prefix}flange_joint" type="fixed">
      <parent link="${prefix}wrist_3_link"/><child link="${prefix}flange_link"/>
      <origin xyz="0 0.06 0" rpy="${-pi/2} 0 0"/>
    </joint>
  </xacro:macro>
</robot>
