<?xml version="1.0"?>
<!-- Kinova Gen3 (7-DOF, no vision module, no gripper), primitives only. Joint frames, limits,
     velocity and effort: gen3_macro.xacro of ros2_kortex (BSD-3; read, not copied), which follow the
     Gen3 user guide DH table (segment lengths 0.1564 + 0.1284, 0.0054 + 0.0064, 0.2104 + 0.2104,
     0.0064 + 0.0064, 0.2084 + 0.1059, 0.1059 + 0.0615 m). Joints 1, 3, 5, 7 are continuous on the
     real arm (no external cable); here they are revolute +-2 pi (one turn each way) so the arm
     contract (N revolute joints with limits) holds. Joint 2 +-2.24, joint 4 +-2.57, joint 6 +-2.09 rad;
     1.3963 rad/s (joints 1-4), 1.2218 rad/s (5-7); 39 / 9 N m. The flange is the end-effector frame of
     the bracelet (z pointing out, so the frame is flipped about x). No vendor mesh. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="kinova_gen3_arm" params="parent *origin prefix:='arm_'">
    <xacro:sa_base prefix="${prefix}" parent="${parent}"><xacro:insert_block name="origin"/></xacro:sa_base>

    <xacro:sa_link name="${prefix}link1" radius="0.05" from_z="0.15643" to_y="0.005375" to_z="-0.12838"/>
    <xacro:sa_joint prefix="${prefix}" n="1" parent="${prefix}base_link" child="${prefix}link1"
      xyz="0 0 0.15643" rpy="${pi} 0 0" lower="${-2*pi}" upper="${2*pi}" velocity="1.3963" effort="39"/>

    <xacro:sa_link name="${prefix}link2" radius="0.05" to_y="-0.21038" to_z="-0.006375"/>
    <xacro:sa_joint prefix="${prefix}" n="2" parent="${prefix}link1" child="${prefix}link2"
      xyz="0 0.005375 -0.12838" rpy="${pi/2} 0 0" lower="-2.24" upper="2.24" velocity="1.3963" effort="39"/>

    <xacro:sa_link name="${prefix}link3" radius="0.045" to_y="0.006375" to_z="-0.21038"/>
    <xacro:sa_joint prefix="${prefix}" n="3" parent="${prefix}link2" child="${prefix}link3"
      xyz="0 -0.21038 -0.006375" rpy="${-pi/2} 0 0" lower="${-2*pi}" upper="${2*pi}" velocity="1.3963" effort="39"/>

    <xacro:sa_link name="${prefix}link4" radius="0.045" to_y="-0.20843" to_z="-0.006375"/>
    <xacro:sa_joint prefix="${prefix}" n="4" parent="${prefix}link3" child="${prefix}link4"
      xyz="0 0.006375 -0.21038" rpy="${pi/2} 0 0" lower="-2.57" upper="2.57" velocity="1.3963" effort="39"/>

    <xacro:sa_link name="${prefix}link5" radius="0.04" to_y="0.00017505" to_z="-0.10593"/>
    <xacro:sa_joint prefix="${prefix}" n="5" parent="${prefix}link4" child="${prefix}link5"
      xyz="0 -0.20843 -0.006375" rpy="${-pi/2} 0 0" lower="${-2*pi}" upper="${2*pi}" velocity="1.2218" effort="9"/>

    <xacro:sa_link name="${prefix}link6" radius="0.04" to_y="-0.10593" to_z="-0.00017505"/>
    <xacro:sa_joint prefix="${prefix}" n="6" parent="${prefix}link5" child="${prefix}link6"
      xyz="0 0.00017505 -0.10593" rpy="${pi/2} 0 0" lower="-2.09" upper="2.09" velocity="1.2218" effort="9"/>

    <xacro:sa_link name="${prefix}link7" radius="0.04" to_z="-0.061525"/>
    <xacro:sa_joint prefix="${prefix}" n="7" parent="${prefix}link6" child="${prefix}link7"
      xyz="0 -0.10593 -0.00017505" rpy="${-pi/2} 0 0" lower="${-2*pi}" upper="${2*pi}" velocity="1.2218" effort="9"/>

    <xacro:sa_flange prefix="${prefix}" last="${prefix}link7" xyz="0 0 -0.061525" rpy="${pi} 0 0"/>
  </xacro:macro>
</robot>
