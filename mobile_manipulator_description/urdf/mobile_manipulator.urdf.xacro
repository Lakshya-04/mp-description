<?xml version="1.0"?>
<!-- Mobile manipulator: base + lift + N-DOF arm + tool = 1 + N actuated DOF (N = 6 for the
     UR and generic arms, 7 for the Panda-like arm; the profile says).

     Every part is swappable behind a small contract (see each file's header):
       base  urdf/base/base.xacro  (generic_base | ranger_mini | scout_mini | scout | husky | mpo_500 | mir100 | turtlebot3_*)
       lift  urdf/lift/lift.xacro  (telescopic | scissor | fixed | none)
       arm   urdf/arms/arm.xacro  (generic_6dof | panda | fr3 | iiwa7 | kinova_gen3 | xarm7 | ur3 | ur5 | ur10 | ur10e | ur16e | ur20 | ...)
       tool  urdf/tools/generic_tool.xacro

     Render:  xacro mobile_manipulator.urdf.xacro arm:=ur10e lift_stroke:=1.5 tcp_xyz:="0 0 0.165"

     Frames:  base_footprint > base_link > lift_mount_link > lift_base_link > (lift_joint) >
              lift_carriage_link > lift_output_link > arm_base_link > ... > arm_flange_link >
              tool_mount_link > tcp_link -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_manipulator">

  <xacro:arg name="base" default="generic_base"/>
  <xacro:arg name="arm" default="ur10e"/>
  <!-- telescopic | scissor | fixed | none, all behind the same lift contract (urdf/lift/lift.xacro). -->
  <xacro:arg name="lift" default="telescopic"/>
  <xacro:arg name="lift_stroke" default="1.5"/>
  <xacro:arg name="lift_stages" default="2"/>
  <xacro:arg name="lift_max_velocity" default="0.2"/>
  <xacro:arg name="lift_max_acceleration" default="0.5"/>
  <!-- Height of lift_output_link above lift_base_link when retracted; empty = the variant default. -->
  <xacro:arg name="lift_mount_height" default=""/>
  <!-- Empty = moving lift. A number (m) pins the lift at that extension: an arm-only robot
       (lift:=fixed does the same and defaults to 0.4 m). -->
  <xacro:arg name="lift_fixed_height" default=""/>
  <xacro:arg name="lift_mount_xyz" default="0 0 0"/>
  <xacro:arg name="arm_mount_xyz" default="0 0 0.02"/>
  <xacro:arg name="arm_mount_rpy" default="0 0 0"/>
  <xacro:arg name="tcp_xyz" default="0 0 0.165"/>
  <xacro:arg name="tcp_rpy" default="0 0 0"/>
  <!-- "none" (description only) or "mock" (adds the ros2_control block with mock hardware). -->
  <xacro:arg name="hardware" default="none"/>
  <!-- hardware:=real only (config/hardware_drivers.yaml, docs/hardware_bringup.md): the vendor driver
       ("auto" = by arm; ufactory | ur | franka | mock), its required parameters as "key=value,key=value",
       and the ros2_control plugin of the lift (empty = the driver table's, which only mock has). -->
  <xacro:arg name="real_driver" default="auto"/>
  <xacro:arg name="real_params" default=""/>
  <xacro:arg name="real_lift_plugin" default=""/>

  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/generic_base.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/ranger_mini.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/scout_mini.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/scout.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/husky.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/mpo_500.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/mir100.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/turtlebot3_burger.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/turtlebot3_waffle.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/base.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/lift/telescopic_lift.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/lift/scissor_lift.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/lift/lift.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/tools/generic_tool.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/arms/generic_6dof_arm.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/arms/panda_arm.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/arms/serial_arm_common.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/arms/fr3_arm.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/arms/iiwa7_arm.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/arms/kinova_gen3_arm.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/arms/xarm7_arm.xacro"/>
  <xacro:if value="${'$(arg arm)'.startswith('ur')}">
    <xacro:include filename="$(find mobile_manipulator_description)/urdf/arms/ur_arm.xacro"/>
  </xacro:if>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/arms/arm.xacro"/>

  <xacro:base base_type="$(arg base)"/>

  <xacro:lift lift_type="$(arg lift)" parent="lift_mount_link"
    stroke="$(arg lift_stroke)" stages="$(arg lift_stages)" max_velocity="$(arg lift_max_velocity)"
    max_acceleration="$(arg lift_max_acceleration)" mount_height="$(arg lift_mount_height)"
    fixed_height="$(arg lift_fixed_height)"
    arm_mount_xyz="$(arg arm_mount_xyz)" arm_mount_rpy="$(arg arm_mount_rpy)">
    <origin xyz="$(arg lift_mount_xyz)" rpy="0 0 0"/>
  </xacro:lift>

  <xacro:arm arm_type="$(arg arm)" parent="lift_output_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:arm>

  <!-- hardware:=gazebo mounts the tool on ft_sensor_link (zero offset from the flange, defined in
       sim_gazebo) so the F/T sensor sits between the flange and the tool. There the tool body has no
       collision of its own: sim_gazebo adds a spring-loaded tip link that carries it. -->
  <xacro:generic_tool parent="${'ft_sensor_link' if '$(arg hardware)' == 'gazebo' else 'arm_flange_link'}" tcp_xyz="$(arg tcp_xyz)" tcp_rpy="$(arg tcp_rpy)"
    collision="${'$(arg hardware)' != 'gazebo'}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:generic_tool>

  <xacro:unless value="${'$(arg hardware)' == 'none'}">
    <xacro:include filename="$(find mobile_manipulator_description)/urdf/mobile_manipulator.ros2_control.xacro"/>
    <xacro:mobile_manipulator_ros2_control hardware="$(arg hardware)"/>
  </xacro:unless>

</robot>
