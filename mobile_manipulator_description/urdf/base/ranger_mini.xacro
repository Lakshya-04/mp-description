<?xml version="1.0"?>
<!-- AgileX Ranger Mini 2.0: four-wheel steering (omni / Ackermann / spin).
     Primitive model from nominal published dimensions; check every default against your unit
     (see docs/robot_description.md) and override through the macro parameters. Wheels are fixed
     links: the base is driven by its vehicle controller, not by the planner. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/wheeled_base_common.xacro"/>
  <xacro:macro name="ranger_mini_base" params="prefix:='' length:=0.738 width:=0.497 height:=0.224 ground_clearance:=0.04 mass:=70.0 rgba:='0.15 0.17 0.2 1' wheel_radius:=0.0825 wheel_width:=0.06 track:=0.364 wheelbase:=0.494 wheel_collision:=false mount_x:=0.0 mount_y:=0.0">
    <xacro:four_wheel_base prefix="${prefix}"
    length="${length}"
    width="${width}"
    height="${height}"
    ground_clearance="${ground_clearance}"
    mass="${mass}"
    rgba="${rgba}"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    track="${track}"
    wheelbase="${wheelbase}"
    wheel_collision="${wheel_collision}"
    mount_x="${mount_x}" mount_y="${mount_y}"/>
  </xacro:macro>
</robot>
