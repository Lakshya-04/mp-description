<?xml version="1.0"?>
<!-- Parametric telescopic lift column: one controlled master prismatic joint (full stroke) that
     carries the arm, and 0..3 visual/collision stages that follow it through <mimic> joints, each
     moving stroke/stages relative to the stage below. Only `lift_joint` is commanded.

     Contract (what a replacement lift must provide):
       link  `${prefix}lift_base_link`    fixed to the parent
       joint `${prefix}lift_joint`        prismatic, axis +z, lower 0, upper `stroke`
       link  `${prefix}lift_output_link`  the arm attaches here (moves with lift_joint)
     Mimic stage joints are optional and are not commanded. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One telescoping stage link + its mimic joint. `index` is 1-based, `of` is the stage count. -->
  <xacro:macro name="lift_stage" params="prefix index of stroke parent_link tube_radius tube_length">
    <link name="${prefix}lift_stage_${index}_link">
      <visual>
        <origin xyz="0 0 ${tube_length / 2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${tube_radius}" length="${tube_length}"/></geometry>
        <material name="lift_silver"><color rgba="0.7 0.72 0.75 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${tube_length / 2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${tube_radius}" length="${tube_length}"/></geometry>
      </collision>
      <inertial><mass value="2.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.01"/></inertial>
    </link>
    <joint name="${prefix}lift_stage_${index}_joint" type="prismatic">
      <parent link="${parent_link}"/>
      <child link="${prefix}lift_stage_${index}_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="${stroke / of}" effort="1000" velocity="1.0"/>
      <mimic joint="${prefix}lift_joint" multiplier="${1.0 / of}" offset="0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="telescopic_lift" params="parent *origin prefix:='' stroke:=1.5 stages:=2 max_velocity:=0.2 max_effort:=2000.0 column_height:=0.8 column_width:=0.18 arm_mount_xyz:='0 0 0.02' arm_mount_rpy:='0 0 0'">

    <xacro:property name="n_stages" value="${int(stages)}"/>
    <xacro:property name="tube_h" value="${column_height}"/>

    <!-- Fixed outer column. -->
    <link name="${prefix}lift_base_link">
      <visual>
        <origin xyz="0 0 ${column_height / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${column_width} ${column_width} ${column_height}"/></geometry>
        <material name="lift_dark"><color rgba="0.25 0.27 0.3 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${column_height / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${column_width} ${column_width} ${column_height}"/></geometry>
      </collision>
      <inertial><mass value="10.0"/><inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.1"/></inertial>
    </link>
    <joint name="${prefix}lift_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}lift_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Moving carriage: driven by the single master joint over the full stroke. It sits at the
         top of the fixed column when the lift is retracted. -->
    <link name="${prefix}lift_carriage_link">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><box size="${column_width * 1.4} ${column_width * 1.4} 0.04"/></geometry>
        <material name="lift_plate"><color rgba="0.55 0.57 0.6 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><box size="${column_width * 1.4} ${column_width * 1.4} 0.04"/></geometry>
      </collision>
      <inertial><mass value="3.0"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
    </link>
    <joint name="${prefix}lift_joint" type="prismatic">
      <parent link="${prefix}lift_base_link"/>
      <child link="${prefix}lift_carriage_link"/>
      <origin xyz="0 0 ${column_height}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="${stroke}" effort="${max_effort}" velocity="${max_velocity}"/>
    </joint>

    <!-- Optional telescoping stages that follow the master joint (visual / collision only). -->
    <xacro:if value="${n_stages >= 1}">
      <xacro:lift_stage prefix="${prefix}" index="1" of="${n_stages}" stroke="${stroke}"
        parent_link="${prefix}lift_base_link" tube_radius="${column_width * 0.4}" tube_length="${column_height}"/>
    </xacro:if>
    <xacro:if value="${n_stages >= 2}">
      <xacro:lift_stage prefix="${prefix}" index="2" of="${n_stages}" stroke="${stroke}"
        parent_link="${prefix}lift_stage_1_link" tube_radius="${column_width * 0.32}" tube_length="${column_height}"/>
    </xacro:if>
    <xacro:if value="${n_stages >= 3}">
      <xacro:lift_stage prefix="${prefix}" index="3" of="${n_stages}" stroke="${stroke}"
        parent_link="${prefix}lift_stage_2_link" tube_radius="${column_width * 0.25}" tube_length="${column_height}"/>
    </xacro:if>

    <!-- Where the arm attaches. -->
    <link name="${prefix}lift_output_link"/>
    <joint name="${prefix}lift_output_joint" type="fixed">
      <parent link="${prefix}lift_carriage_link"/>
      <child link="${prefix}lift_output_link"/>
      <origin xyz="${arm_mount_xyz}" rpy="${arm_mount_rpy}"/>
    </joint>
  </xacro:macro>
</robot>
