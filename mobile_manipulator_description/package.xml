<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_description</name>
  <version>0.1.0</version>
  <description>
    Generic mobile manipulator description: base + swappable lift (telescopic, mimic stages) +
    swappable 6-DOF arm (generic reference arm, Universal Robots via ur_description) + tool.
    Seven actuated DOF. Includes a profile YAML as the single source of joint names and limits,
    an SRDF, and contract tests.
  </description>
  <maintainer email="100lakshyaagarwal@gmail.com">Lakshya Agarwal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>python3-yaml</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <!-- Only needed when rendering with arm:=ur*; not required for the generic arm. -->
  <exec_depend>ur_description</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>urdfdom_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
